# ============================================================
# 企业文档知识库 RAG —— 环境变量模板
#
# 用法：复制本文件为 .env，填入自己的密钥后即可启动。
#     cp .env.example .env
#     # 编辑 .env，至少填 ZHIPU_API_KEY
#     python scripts/run.py
#
# 优先级：默认值 < .env < data/config/runtime.json（Web 界面改动会写入后者）
# ============================================================

# ---------- 必填：智谱 AI ----------
# 获取地址：https://open.bigmodel.cn/  （用户中心 -> API Keys）
ZHIPU_API_KEY=

# ---------- 模型 ----------
# 对话模型：glm-4-flash / glm-4.6v 等
CHAT_MODEL=glm-4-flash
# 视觉模型：用于把图片、扫描件 PDF 解析为文字描述（glm-4v-flash 免费额度易限流）
VISION_MODEL=glm-4v-flash
# 向量模型：embedding-2（1024 维）/ embedding-3（2048 维）
# ⚠️ 两者维度不同，不能混用同一索引；切换后建议在「知识管理」里一键重建
EMBEDDING_MODEL=embedding-2

# ---------- 向量服务商（可切换为阿里云百炼） ----------
# zhipu（默认）| dashscope
EMBEDDING_PROVIDER=zhipu
# 向量维度，0 表示使用模型默认维度
EMBEDDING_DIM=0
# 使用 dashscope 时必填
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---------- 语音（识别 / 合成） ----------
VOICE_MODEL=qwen-tts-latest
TTS_MODEL=qwen-tts-latest
TTS_VOICE=Cherry

# ---------- 文档分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 分块策略：recursive | markdown | token
SPLITTER_TYPE=recursive
# 分隔符优先级（逗号分隔，留空使用默认值）
SEPARATORS=

# ---------- 检索与生成 ----------
TOP_K=4
TEMPERATURE=0.3
TOP_P=0.9

# ---------- 联网搜索兜底（知识库答不了就上网找） ----------
# 0 / false 关闭
WEB_SEARCH_ENABLED=1
# search_std / search_pro / search_pro_sogou / search_pro_quark
WEB_SEARCH_ENGINE=search_std
WEB_SEARCH_COUNT=5

# ---------- 多轮上下文机制 ----------
# 追问改写：把「它有什么风险」「那成本呢」这类依赖上文的追问，结合历史改写成
# 可独立检索的完整问题后再去检索（只影响检索，不影响回答措辞）。0 / false 关闭。
CONTEXT_REWRITE_ENABLED=1
# 送入模型的历史轮数上限
CONTEXT_MAX_TURNS=8
# 送入模型的历史总字符预算（超长回答会先做头尾截断再累加）
CONTEXT_CHAR_BUDGET=6000

# ---------- 服务端口 ----------
API_HOST=127.0.0.1
API_PORT=8000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
