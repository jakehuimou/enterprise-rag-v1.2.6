# ===================== 智谱 AI 配置 =====================
# 必填：前往 https://open.bigmodel.cn 注册并获取 API Key
ZHIPU_API_KEY=

# 向量化模型（默认 embedding-2，1024 维，支持中英文）
EMBEDDING_MODEL=embedding-2

# 对话大模型（仅保留三个：glm-4-flash 纯文本 / glm-4v-flash 视觉 / glm-4.6v 视觉）
CHAT_MODEL=glm-4-flash

# 图片解析用的视觉模型（用于把图片转成文字描述；可选 glm-4v-flash / glm-4.6v）
VISION_MODEL=glm-4v-flash

# ===================== 文档分块配置 =====================
# 分块策略：recursive（递归字符，通用默认）| markdown（按标题）| token（按Token）
SPLITTER_TYPE=recursive

# 块大小（字符数 / token数，取决于分块策略）
CHUNK_SIZE=500

# 上下文重叠（保持语义连贯）
CHUNK_OVERLAP=80

# 分隔符优先级（递归拆分使用，越靠前优先级越高）
SEPARATORS=\n\n,\n,。,！,？,，,、, ,

# ===================== 检索 / 推理配置 =====================
# 向量检索召回数量
TOP_K=4

# 生成温度（0~1，越低越稳定）
TEMPERATURE=0.3

# 生成 top_p
TOP_P=0.9

# ===================== 联网搜索兜底配置 =====================
# 知识库/会话附件检索不到相关内容（或模型自检判定「答不了」）时，
# 自动调用智谱联网搜索（Web Search API）检索互联网资料补充作答，
# 回答开头会给出「已自动联网搜索」提示，来源列表中标记为「联网」并附链接。
# 关闭：WEB_SEARCH_ENABLED=0
WEB_SEARCH_ENABLED=1

# 搜索引擎：search_std（标准版）/ search_pro（高阶版）/ search_pro_sogou（搜狗）/ search_pro_quark（夸克）
WEB_SEARCH_ENGINE=search_std

# 每次联网检索的结果条数（1~50）
WEB_SEARCH_COUNT=5

# ===================== 服务端口配置 =====================
API_HOST=127.0.0.1
API_PORT=8000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# ===================== 阿里云百炼（DashScope）向量模型配置 =====================
# 用于「文档管理 → 向量模型与 API 设置」中选择 qwen3.7-text-embedding（文本）/
# qwen3-vl-embedding（多模态）。也可直接在 Web 界面填写并保存（会写入 data/config/runtime.json，优先级更高）。
#
# Base URL 说明：
#   · 专属业务空间（workspace）：形如 https://{workspaceId}.cn-beijing.maas.aliyuncs.com
#     （取值见控制台下载的「xxx业务空间-apiKey-xxxx.csv」中的 apiHost）
#   · 公网通用域名：https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-50u61kpgw9o7p4us.cn-beijing.maas.aliyuncs.com

# 向量模型服务商：zhipu（智谱 AI，默认）| dashscope（阿里云百炼）
# 也可只改 EMBEDDING_MODEL，服务端会按模型名自动切换服务商。
EMBEDDING_PROVIDER=zhipu

# 向量维度：0 = 模型默认维度（qwen3.7-text-embedding 默认 1024，qwen3-vl-embedding 默认 2560）
# 可选 256 / 512 / 768 / 1024 / 1536 / 2048 / 2560
EMBEDDING_DIM=0
